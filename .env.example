# ==============================================================================
# DiceClash Backend Configuration (.env.example)
# Copy to .env and configure for either Localhost or Sepolia Testnet
# ==============================================================================

PORT=5001

# --- NETWORK & RPC ---
# For Localhost:  http://127.0.0.1:8545 (CHAIN_ID=31337)
# For Sepolia:    https://rpc.sepolia.org or your Infura/Alchemy RPC URL (CHAIN_ID=11155111)
RPC_URL=https://rpc.sepolia.org
CHAIN_ID=11155111

# --- CONTRACT ADDRESSES ---
# If left empty, backend automatically attempts to read from src/deployedAddresses.json
CONTRACT_ADDRESS=
USDT_ADDRESS=
VRF_COORDINATOR=
TREASURY_ADDRESS=

# --- HISTORICAL INDEXING ---
# REQUIRED on Sepolia when starting fresh (set to the block number when MultiplayerDiceRoll was deployed).
# On localhost, defaults to 0 if omitted.
START_BLOCK=
INDEXER_CHUNK_SIZE=2000
POLL_INTERVAL_MS=3000

# --- AUTOMATED KEEPER SERVICE ---
# Keep FALSE by default. Contract functions (lockRound, closeRevealAndRequestRoll) can be called permissionlessly by players.
# If set to true, you MUST supply a valid, funded private key in KEEPER_PRIVATE_KEY.
ENABLE_DEV_KEEPER=false
# NEVER hardcode or share private keys. Leave empty unless ENABLE_DEV_KEEPER is explicitly true.
KEEPER_PRIVATE_KEY=
